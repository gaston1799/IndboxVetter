# Server
NODE_ENV=development
PORT=5173
HOST=0.0.0.0
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_DAYS=30
SESSION_COOKIE_NAME=iv.session
SESSION_SECURE_COOKIES=false
DATA_ENCRYPTION_KEY=replace-with-32-byte-secret

# Public app metadata
BUILD_TIME=
GIT_COMMIT=
RENDER_GIT_COMMIT=
VERCEL_GIT_COMMIT_SHA=

# OpenAI
OPENAI_API_KEY=
HOUSE_OPENAI_KEY=
HOUNDOPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google sign-in / Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_REDIRECT_URI=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PMC_ID=

# App behavior
ADMIN_EMAILS=
CREATOR_EMAIL=
GMAIL_QUERY=label:inbox
GMAIL_MAX_RESULTS=200
GMAIL_WINDOW_DAYS=7
SAFE_MODE=true
ALLOW_ATTACHMENTS=true
MAX_ATTACHMENT_MB=5
MAX_IMAGES=3
MAX_PDF_TEXT_CHARS=4000
VETTER_RUN_HOUR=3
